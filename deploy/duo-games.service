[Unit]
Description=LancoAI duo-games
After=network-online.target
Wants=network-online.target
[Service]
User=duo-games
Group=duo-games
ProtectHome=true
MemoryMax=256M
Type=simple
WorkingDirectory=/opt/lancoai/duo-games
ExecStart=/usr/local/bin/node --disable-warning=ExperimentalWarning dist/server.js
Environment="NODE_ENV=production"
Environment="PORT=18790"
Environment="BASE_PATH=/"
Environment="DATA_DIR=/var/lib/duo-games"
Environment="TRUST_PROXY=1"
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/duo-games
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
